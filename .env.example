# Local pilot-shaped defaults. Replace every placeholder before production.

RDS_RUNTIME_ENV=development
RDS_AUTH_MODE=dev

# Backend API / metadata database
SAAS_DATABASE_URL=sqlite:///./.saas/metadata.db
SAAS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAAS_HSTS_MAX_AGE_SECONDS=31536000
SAAS_SECURITY_REVIEW_URL=
SAAS_SECURITY_REVIEWED_AT=
SAAS_SECURITY_REVIEW_MAX_AGE_DAYS=90
SAAS_TENANT_ISOLATION_REVIEW_URL=
SAAS_TENANT_ISOLATION_REVIEWED_AT=
SAAS_TENANT_ISOLATION_REVIEW_MAX_AGE_DAYS=90

# Artifact storage
SAAS_ARTIFACT_STORE_BACKEND=local
SAAS_ARTIFACT_STORE_DIR=.saas-artifacts
SAAS_S3_BUCKET=
SAAS_S3_PREFIX=
SAAS_S3_ENDPOINT_URL=
SAAS_S3_REGION=
SAAS_ARTIFACT_STORE_GOVERNANCE_URL=
SAAS_ARTIFACT_STORE_GOVERNANCE_VERIFIED_AT=
SAAS_ARTIFACT_STORE_GOVERNANCE_MAX_AGE_DAYS=30

# Clerk frontend/auth mode
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk backend verification
CLERK_ISSUER=
CLERK_JWT_KEY=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_CLOCK_SKEW_SECONDS=5
CLERK_WEBHOOK_SIGNING_SECRET=
SAAS_AUTH_FLOW_VERIFICATION_URL=
SAAS_AUTH_FLOW_VERIFIED_AT=
SAAS_AUTH_FLOW_VERIFICATION_MAX_AGE_DAYS=30

# Billing provider
SAAS_BILLING_PROVIDER=local
SAAS_BILLING_APP_BASE_URL=http://localhost:3000
SAAS_BILLING_WEBHOOK_SECRET=
SAAS_BILLING_WEBHOOK_TOLERANCE_SECONDS=300
SAAS_BILLING_OPERATIONS_URL=
SAAS_BILLING_OPERATIONS_VERIFIED_AT=
SAAS_BILLING_OPERATIONS_MAX_AGE_DAYS=30
STRIPE_SECRET_KEY=
SAAS_STRIPE_PRICE_ID_TEAM=
SAAS_STRIPE_API_BASE_URL=

# Notification delivery
SAAS_EMAIL_BACKEND=memory
SAAS_SMTP_HOST=
SAAS_SMTP_PORT=587
SAAS_SMTP_USERNAME=
SAAS_SMTP_PASSWORD=
SAAS_SMTP_FROM_EMAIL=
SAAS_SMTP_USE_TLS=true
SAAS_SMTP_TIMEOUT_SECONDS=10
SAAS_EMAIL_DELIVERY_VERIFICATION_URL=
SAAS_EMAIL_DELIVERY_VERIFIED_AT=
SAAS_EMAIL_DELIVERY_VERIFICATION_MAX_AGE_DAYS=30
SAAS_NOTIFICATION_MAX_ATTEMPTS=3
SAAS_NOTIFICATION_RETRY_DELAY_SECONDS=300
SAAS_NOTIFICATION_PROVIDER_WEBHOOK_SECRET=
SAAS_NOTIFICATION_PROVIDER_WEBHOOK_TOLERANCE_SECONDS=300
SAAS_MARKETING_INQUIRY_RECIPIENT_EMAIL=
SAAS_MARKETING_INQUIRY_CRM_WEBHOOK_URL=
SAAS_MARKETING_INQUIRY_CRM_WEBHOOK_SECRET=
SAAS_MARKETING_INQUIRY_CRM_WEBHOOK_TIMEOUT_SECONDS=5
SAAS_MARKETING_INQUIRY_RATE_LIMIT_ENABLED=true
SAAS_MARKETING_INQUIRY_RATE_LIMIT_MAX=5
SAAS_MARKETING_INQUIRY_RATE_LIMIT_WINDOW_MINUTES=60
SAAS_MARKETING_INQUIRY_RATE_LIMIT_SECRET=

# Operational monitoring
RDS_METRICS_TOKEN=
SAAS_SUPPORT_ACCESS_TOKEN=
SAAS_SUPPORT_OWNER_EMAIL=
SAAS_LOG_AGGREGATION_URL=
SAAS_LOG_AGGREGATION_VERIFIED_AT=
SAAS_LOG_AGGREGATION_MAX_AGE_DAYS=30
SAAS_LOG_RETENTION_DAYS=90
SAAS_BACKUP_POLICY_URL=
SAAS_BACKUP_JOB_URL=
SAAS_BACKUP_JOB_VERIFIED_AT=
SAAS_BACKUP_MAX_JOB_AGE_DAYS=7
SAAS_BACKUP_RESTORE_TESTED_AT=
SAAS_BACKUP_MAX_RESTORE_TEST_AGE_DAYS=90
SAAS_ALERT_WEBHOOK_URL=
SAAS_ALERT_RUNBOOK_URL=
SAAS_ALERT_RULES_URL=
SAAS_ALERT_RULES_VERIFIED_AT=
SAAS_ALERT_RULES_MAX_AGE_DAYS=30
SAAS_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
SAAS_ALERT_DELIVERY_TEST_MAX_AGE_DAYS=30
SAAS_ALERT_NOTIFICATION_DUE_AGE_SECONDS=900
SAAS_ALERT_NOTIFICATION_FAILED_COUNT=1
SAAS_ALERT_REPORT_SCHEDULE_DUE_AGE_SECONDS=900
SAAS_ALERT_REPORT_SCHEDULE_FAILED_COUNT=1
SAAS_PROVIDER_WEBHOOK_REPLAY_MAX_AGE_DAYS=30
SAAS_ARTIFACT_STORE_TEST_MAX_AGE_DAYS=30
SAAS_DATABASE_TEST_MAX_AGE_DAYS=30
SAAS_TENANT_ISOLATION_TEST_MAX_AGE_DAYS=30
SAAS_RUN_LIFECYCLE_TEST_MAX_AGE_DAYS=30
SAAS_WORKER_RUN_LIFECYCLE_TEST_MAX_AGE_DAYS=30
SAAS_CSP_REPORT_RETENTION_DAYS=30

# Background analysis worker
SAAS_WORKER_ENABLED=false
SAAS_WORKER_ID=default
SAAS_WORKER_POLL_SECONDS=10
SAAS_WORKER_BATCH_SIZE=10
SAAS_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
SAAS_WORKER_SUPERVISOR_URL=
SAAS_WORKER_SUPERVISOR_VERIFIED_AT=
SAAS_WORKER_SUPERVISOR_MAX_AGE_DAYS=30
SAAS_WORKER_ORGANIZATION_ID=
SAAS_WORKER_RUN_ONCE=false
